{
  "name": "memecoin-markets",
  "version": "0.2.0",
  "description": "Free CoinMarketCap-style memecoin tracker for memecoin.markets: rankings (market cap, volume, liquidity, gainers, losers, trending, new pairs), SEO token pages with holders, LP, charts and rug/honeypot scans, guides; plus the safety scanner, radar, UK CGT PnL, SDK, MCP and static JSON API. Free public data only, no API keys.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "memecoin-mcp": "bin/memecoin-mcp.js"
  },
  "files": [
    "src",
    "bin",
    "types",
    "README.md",
    "LICENSE",
    "blocks.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:site": "node scripts/build-site.mjs",
    "test:unit": "node --test test/unit.test.mjs test/telegram.test.mjs test/markets.test.mjs",
    "test:live": "node --test --test-concurrency=1 test/live.test.mjs test/mcp.test.mjs",
    "test:e2e": "node --test test/e2e.test.mjs",
    "test": "npm run test:unit && npm run test:live"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@noble/hashes": "^1.8.0",
    "@solana-program/token": "^0.17.0",
    "@solana/kit": "^8.4.0",
    "grammy": "^1.46.0",
    "lightweight-charts": "^5.2.1",
    "pagefind": "^1.5.2",
    "playwright-core": "^1.64.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blockchains/memecoin-markets.git"
  },
  "homepage": "https://blockchains.github.io/memecoin-markets/",
  "author": "Blockchain Lab (https://blockchainlab.com)",
  "license": "MIT",
  "keywords": [
    "coingecko",
    "coinmarketcap-alternative",
    "dexscreener",
    "geckoterminal",
    "honeypot",
    "jupiter",
    "mcp",
    "memecoin",
    "memecoin-rankings",
    "pnl",
    "rugcheck",
    "seo",
    "solana",
    "static-site",
    "token-safety",
    "uk-cgt"
  ]
}
